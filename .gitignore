# --- secrets ---------------------------------------------------------------
# .env holds the database URI, JWT signing keys and live API keys.
# Only .env.example is ever committed.
.env
.env.local
.env.*.local
# .env.example is intentionally NOT committed.
# Every variable is documented in the README instead.
.env.example

# --- dependencies and build output ----------------------------------------
node_modules/
dist/
*.tsbuildinfo

# --- tests ----------------------------------------------------------------
coverage/

# mongodb-memory-server downloads a mongod binary here on first test run
.cache/
.mongodb-binaries/

# --- logs -----------------------------------------------------------------
logs/
*.log
npm-debug.log*

# --- platform -------------------------------------------------------------
.render/
.vercel/

# --- generated artefacts --------------------------------------------------
# Quotation PDFs are rendered on demand and never written to disk, but keep
# stray local output out of git.
*.pdf
tmp/

# --- editors / OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
