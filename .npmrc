# Always install devDependencies, whatever NODE_ENV says.
#
# Render and Vercel both set NODE_ENV=production, and npm reads NODE_ENV to
# decide what to install: under `production` it sets `omit=dev` and skips every
# devDependency. TypeScript and the build tooling live there, so a plain
# `npm install` on those platforms produces a tree that cannot build —
# "sh: tsc: not found", or a fall-through to some other compiler on PATH.
#
# Pinning it here rather than in a build command means the repository enforces
# it: no dashboard setting to remember, and it cannot drift between platforms.
#
# This affects INSTALL only. The built output and the runtime are unchanged.
include=dev
